{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanban",
  "version": "0.3.1",
  "identifier": "dev.agentic-kit.kanban",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Kanban board for spec-driven work with Claude Code",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../scripts/*.py": "kanban/scripts/",
      "../../ui/*.js": "kanban/ui/",
      "../../ui/*.css": "kanban/ui/",
      "../../ui/*.html": "kanban/ui/",
      "../../ui/modules/*": "kanban/ui/modules/",
      "../../ui/vendor/xterm/*": "kanban/ui/vendor/xterm/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
